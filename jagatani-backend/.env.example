# Konfigurasi Lingkungan JagaTani Backend (.env)
# Salin file ini menjadi .env: cp .env.example .env

# ── Konfigurasi MQTT Broker ──────────────────────────────
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=jagatani/sensor/#
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=jagatani_backend_listener

# ── Konfigurasi Koordinat Default Lahan (Open-Meteo) ──────
DEFAULT_LAT=-6.5971
DEFAULT_LNG=106.8060
TIMEZONE=Asia/Jakarta

# ── Konfigurasi Server FastAPI ───────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
